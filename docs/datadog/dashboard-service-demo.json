{
  "title": "[ordem-servico] dashboard",
  "description": "Dashboard do serviço `ordem-servico-service` na janela GCP (APM + logs). Dashboard geral da Saga: e2e/docs/datadog/.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Latência p95 (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:trace.aspnet_core.request{service:ordem-servico-service,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erros HTTP (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet_core.request.errors{service:ordem-servico-service,env:prod}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Hits HTTP (APM)",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet_core.request.hits{service:ordem-servico-service,env:prod}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime .NET — CPU %",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:runtime.dotnet.cpu.percent{service:ordem-servico-service,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runtime .NET — memória committed",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:runtime.dotnet.mem.committed{service:ordem-servico-service,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Transições OS (todas)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "logs",
                "name": "query1",
                "indexes": [
                  "*"
                ],
                "compute": {
                  "aggregation": "count"
                },
                "group_by": [],
                "search": {
                  "query": "service:ordem-servico-service env:prod \"movida para o status\""
                }
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
