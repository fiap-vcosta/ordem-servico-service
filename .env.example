# PostgreSQL
POSTGRES_DB=ordem_servico
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT RS256 (mesma chave pública do autenticacao-service / .local/jwt/public.pem)
JWT_FUNCIONARIO_ISSUER=ordem-servico-local
JWT_FUNCIONARIO_AUDIENCE=funcionario
JWT_CLIENTE_ISSUER=ordem-servico-local
JWT_CLIENTE_AUDIENCE=cliente
JWT_PUBLIC_KEY_PEM=

# Administrativo (API system + X-Service-Key)
ADMINISTRATIVO_BASE_URL=http://host.docker.internal:8080
SERVICE_AUTH_KEY=local-service-auth-key-change-me

# Datadog (opcional no Compose — sem chave, só JSON no console)
# DD_API_KEY=
# DD_SITE=datadoghq.com
# DD_AGENT_HOST=127.0.0.1

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@techchallenge.com
PGADMIN_DEFAULT_PASSWORD=admin

# GitHub Packages (building-blocks) — necessário no build da imagem
# NUGET_AUTH_TOKEN=
